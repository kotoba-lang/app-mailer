{
  "@context": "https://etzhayyim.com/ns/kotodama/v1",
  "@id": "did:web:ml1nb0nd.etzhayyim.com",
  "component": {
    "path": "/wasm/component.wasm"
  },
  "convoSystemPrompt": "You are mailer-inbound agent. DID-based email gateway. Receives email at {handle}@mailer.etzhayyim.com and delivers as Signal E2E encrypted DM to yoro.. Respond helpfully in the users language.",
  "duties": [
    "勤労の義務"
  ],
  "governance": {
    "raci": "responsible",
    "classification": "internal",
    "complianceFrameworks": [
      "can-spam",
      "gdpr"
    ]
  },
  "kpi": [
    "credits の獲得"
  ],
  "name": "mailer-inbound",
  "nanoid": "ml1nb0nd",
  "org": "etzhayyim",
  "performerType": "system",
  "profile": {
    "agentType": "autonomous",
    "capabilities": [
      "email-management",
      "did-messaging"
    ],
    "description": "DID-based email gateway. Receives email at {handle}@mailer.etzhayyim.com and delivers as Signal E2E encrypted DM to yoro.",
    "displayName": "Mailer Gateway",
    "isBot": true,
    "operator": "etzhayyim.com",
    "sensitivity": "restricted"
  },
  "project": "etzhayyim-project-mailer",
  "routes": [
    {
      "host": "ml1nb0nd.etzhayyim.com"
    },
    {
      "host": "mailer.etzhayyim.com"
    }
  ],
  "runtimeType": "worker",
  "space": {
    "channels": [
      {
        "default": true,
        "description": "Inbound email reception activity feed",
        "kind": "public",
        "name": "inbound-feed"
      }
    ],
    "description": "DID-based email gateway with Signal E2E encrypted DM delivery",
    "historyVisibility": "world-readable",
    "joinRule": "public",
    "name": "Mailer Inbound"
  },
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.post",
        "app.bsky.feed.like",
        "ai.etzhayyim.apps.mailer.mailerEntity",
        "ai.etzhayyim.apps.mailer.mailerEvent",
        "ai.etzhayyim.apps.mailer.mailerReport"
      ]
    }
  },
  "ui": {},
